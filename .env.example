# Backend origin WITHOUT /api (code appends /api/...)
NEXT_PUBLIC_API_URL=http://localhost:5000
# Cloudflare R2 public bucket (product/category/blog images)
NEXT_PUBLIC_IMG_URL=https://<your-bucket>.r2.dev
# Static website images stored in R2
NEXT_PUBLIC_STATIC_URL=https://<your-bucket>.r2.dev/frontend-static-images/images
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# SEO / branding
NEXT_PUBLIC_SITE_NAME=Meenavan Fresh
NEXT_PUBLIC_SITE_URL=http://localhost:3000
